# ============================================================
# Application
# ============================================================

APP_NAME=Norma AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
# Both planes read this. Note that it raises application logging only: the
# media plane deliberately will not follow it below DEBUG, because pipecat
# logs whole frames - callers' words included - at TRACE.
LOG_LEVEL=INFO

# ============================================================
# Database
# ============================================================

POSTGRES_DB=norma
POSTGRES_USER=norma
POSTGRES_PASSWORD=norma
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://norma:norma@postgres:5432/norma

# ============================================================
# Redis
# ============================================================

REDIS_URL=redis://redis:6379/0

# ============================================================
# Security
# ============================================================

SECRET_KEY=replace-this-in-production
INTERNAL_API_SECRET=replace-this-in-production

# ============================================================
# Frontend
# ============================================================

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8080

# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=http://localhost:3000

# ============================================================
# Networking
# ============================================================

# Trusted proxies in front of the API. 0 means direct access and
# X-Forwarded-For is ignored. Behind Cloudflare and Render this must match the
# real chain: it decides which forwarded hop is believed, and that address keys
# the rate limiter. Too high and the header is distrusted; too low and a caller
# can pick its own address.
TRUSTED_PROXY_COUNT=0


# apps/voice's realtime LLM turn loop (item 20d) - "mock" so a fresh
# checkout and the test suite never reach a paid provider without
# deliberately configuring one.
LLM_PROVIDER=mock
LLM_REALTIME_MODEL=claude-haiku-4-5-20251001

# What LLM_REALTIME_MODEL charges, in USD per million tokens, input and
# output priced separately (item 25b). Decimal strings, e.g. 0.15 - never a
# float anywhere in the pipeline, because these are summed into invoices.
#
# Unset by default, and left unset deliberately: a published rate is a fact
# about a vendor on a date, and a stale one baked into the repository would
# report the gross margin as better or worse than it is with nothing to show
# which. Look the current rate up for the model you have configured and put
# it here. Until you do, every turn still records its token counts and
# records the cost as unknown, saying so once in the log.
LLM_REALTIME_INPUT_USD_PER_MTOK=
LLM_REALTIME_OUTPUT_USD_PER_MTOK=
ANTHROPIC_API_KEY=replace-this-in-production
# Empty means "use the SDK default" - only set for a proxy or custom endpoint.
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=replace-this-in-production
# "huggingface" is also a valid EMBEDDING_PROVIDER value, calling a hosted
# HuggingFace Inference Providers router model rather than OpenAI - it needs
# HF_TOKEN set below, and EMBEDDING_MODEL/EMBEDDING_DIMENSION changed to
# match the chosen model (e.g. intfloat/multilingual-e5-base, dimension 768).
HF_TOKEN=replace-this-in-production
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_PROVIDER=mock

# ============================================================
# Retrieval tracing (LangSmith)
# ============================================================

# Tracing is on exactly when this is set - paste a key and every turn's
# retrieval shows up in LangSmith as a retriever run with the embedding call
# and the vector search as child spans. Leave it empty and nothing is sent
# and nothing is imported.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=norma-retrieval
# Empty uses the SDK default (US). Set https://eu.api.smith.langchain.com
# for the EU region.
LANGSMITH_ENDPOINT=

# Whether the caller's question and the retrieved chunk text go to LangSmith
# alongside the scores, identifiers and timings.
#
# Off, and it should stay off anywhere real calls land. CLAUDE.md section 27
# forbids logging transcript text and full document contents; sending them
# to a third-party service is a stronger form of the same thing. The
# question is whatever the caller just said and the chunks are the
# operator's own documents. Turn it on only to debug a corpus you own, with
# callers who are you.
LANGSMITH_TRACE_TEXT=false

# apps/api's own background FAQ-generation LLM call (drafts candidate FAQ
# entries from an ingested knowledge source) - "mock" for the same reason
# every other provider defaults to it. "groq" uses GROQ_API_KEY_SECRET when
# set, falling back to GROQ_API_KEY.
#
# GROQ_API_KEY_SECRET is a key on a *separate Groq account*, so that
# processing a document cannot spend the per-minute and per-day token
# allowance a live call answers from. Rate limits are per account, and
# generation costs about 5,700 tokens a minute - enough to leave a call
# unable to reply at all. Leave it unset to share one account.
GROQ_API_KEY_SECRET=
FAQ_GENERATION_PROVIDER=mock
FAQ_GENERATION_MODEL=openai/gpt-oss-120b

# Starting tokens-per-minute budget for FAQ generation. Groq reports its
# real limit on every response and generation adopts that from the first
# call onwards, so this only has to be small enough that the first window
# is not refused. The observed limit for gpt-oss-120b is 8000.
FAQ_GENERATION_TOKENS_PER_MINUTE=8000

# ============================================================
# Speech
# ============================================================

# "mock" for local development and tests, never a paid provider by default.
# Feature 9b adds "elevenlabs" as a valid value for both.
# How certain and how loud audio must be before it counts as the caller
# speaking, rather than the room behind them. Above pipecat's defaults
# (0.7 / 0.6) because a turn only ever fires on VAD-confirmed speech, so
# whatever clears these is what the assistant answers. Raise them if it picks
# up background voices; lower them if it ignores a softly-spoken caller.
VAD_CONFIDENCE=0.8
VAD_MIN_VOLUME=0.7

STT_PROVIDER=mock
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=replace-this-in-production
# eleven_flash_v2_5 is ElevenLabs' own low-latency model - measured at
# ~330-380ms time-to-first-byte in this environment (English and Hinglish
# both) versus 1.1-2.1s for eleven_multilingual_v2. Only change this if you
# have measured that a different model's quality/language tradeoff is worth
# the added per-turn latency for your use case.
TTS_MODEL_ID=eleven_flash_v2_5

# Whether the caller being transcribed saying something new mid-reply counts
# as an interruption, alongside the VAD speech-onset signal. Needed because
# that onset is edge-triggered and the assistant's own playback returning
# through an open mic (speakers, no headphones) can hold it high across the
# moment the caller starts talking, so the reply plays to the end instead of
# stopping. Set false to fall back to VAD-only barge-in if the echo guards
# below ever misfire in a given room.
BARGE_IN_ON_TRANSCRIPT=true
# How much of a mid-reply transcript's wording must already appear in what
# the assistant is saying (or in the caller's own just-ended turn) for it to
# be treated as that audio coming back rather than a real interruption.
# Raise it to interrupt more eagerly, lower it to be more suspicious of echo.
ECHO_WORD_OVERLAP_RATIO=0.6

# ============================================================
# Storage
# ============================================================

# "local" writes to disk under LOCAL_STORAGE_DIR - free, no credentials
# needed, so a fresh checkout works out of the box. Set "s3" for production
# and fill in the four AWS_* values below.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=data/uploads
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

