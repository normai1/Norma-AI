# ============================================================
# Application
# ============================================================

APP_NAME=Norma AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# ============================================================
# Database
# ============================================================

POSTGRES_DB=norma
POSTGRES_USER=norma
POSTGRES_PASSWORD=norma
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://norma:norma@postgres:5432/norma

# ============================================================
# Redis
# ============================================================

REDIS_URL=redis://redis:6379/0

# ============================================================
# Security
# ============================================================

SECRET_KEY=replace-this-in-production

# ============================================================
# Frontend
# ============================================================

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8080

# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=http://localhost:3000

# ============================================================
# Networking
# ============================================================

# Trusted proxies in front of the API. 0 means direct access and
# X-Forwarded-For is ignored. Behind Cloudflare and Render this must match the
# real chain: it decides which forwarded hop is believed, and that address keys
# the rate limiter. Too high and the header is distrusted; too low and a caller
# can pick its own address.
TRUSTED_PROXY_COUNT=0


ANTHROPIC_API_KEY=replace-this-in-production
OPENAI_API_KEY=replace-this-in-production
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ============================================================
# Speech
# ============================================================

# "mock" for local development and tests, never a paid provider by default.
# Feature 9b adds "elevenlabs" as a valid value for both.
STT_PROVIDER=mock
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=replace-this-in-production

